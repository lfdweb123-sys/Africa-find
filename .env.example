# Anthropic
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=un_token_secret_que_tu_choisis

# Firebase Admin (Firestore) — depuis la clé de service JSON du projet
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase client (authentification par lien email) — valeurs publiques,
# visibles dans le navigateur par nature (voir la config de l'app web
# dans Firebase Console > Paramètres du projet > Vos applications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
